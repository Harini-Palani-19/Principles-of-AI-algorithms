b = [" "] * 9
wins = [(0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)]

def win(p):
    return any(all(b[i] == p for i in w) for w in wins)

def minimax(maxi):
    if win("X"):
        return 1
    if win("O"):
        return -1
    if " " not in b:
        return 0

    scores = []
    for i in range(9):
        if b[i] == " ":
            b[i] = "X" if maxi else "O"
            scores.append(minimax(not maxi))
            b[i] = " "

    return max(scores) if maxi else min(scores)

while " " in b and not win("X") and not win("O"):
    print(b[:3], b[3:6], b[6:])
    pos = int(input("Enter position (0-8): "))

    if pos not in range(9) or b[pos] != " ":
        print("Invalid move!")
        continue

    b[pos] = "O"

    if not win("O") and " " in b:
        best, move = -2, -1

        for i in range(9):
            if b[i] == " ":
                b[i] = "X"
                score = minimax(False)
                b[i] = " "

                if score > best:
                    best, move = score, i

        b[move] = "X"

print(b[:3], b[3:6], b[6:])
print("Computer wins!" if win("X") else
      "You win!" if win("O") else "Draw!")
